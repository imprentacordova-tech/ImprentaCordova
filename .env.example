# =============================================================================
# Imprenta Córdova — Variables de Entorno (Local / Producción)
# =============================================================================

# ── Supabase (Base de datos y Storage en la nube) ───────────────────────────
# Obtén estos valores en https://supabase.com -> Tu Proyecto -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── Backend Facturación Electrónica SRI (Render.com) ─────────────────────────
# Microservicio Express desplegado en Render.com
VITE_RENDER_SRI_API_URL=https://cordova-sri-api.onrender.com
# Clave anti-abuso: es PÚBLICA por diseño (viaja en el navegador) y debe coincidir
# con la variable API_KEY del backend en Render. Sin ella, las rutas privilegiadas responden 503.
VITE_RENDER_API_KEY=tu-clave-api-publica

# ── Google Gemini AI (OCR de RUCs, Análisis de Artes y Visión) ──────────────
# ⚠️ La clave ya NO va en el frontend: todas las llamadas pasan por el backend (Render).
# Configurá GEMINI_API_KEY SOLO en Render. NUNCA como VITE_* (se incrusta en el bundle público).
# Ver GUIA_DESPLIEGUE_Y_OPERACION.md PASO 4.

# ── Configuración de Ambiente SRI ───────────────────────────────────────────
# 1 = Pruebas / Sandbox, 2 = Producción Real
SRI_AMBIENTE=1
