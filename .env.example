# =============================================================================
# Imprenta Córdova — Variables de Entorno
# Copia este archivo como .env y completa los valores
# =============================================================================

# ── Supabase (Frontend) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── SRI API URL (Backend Express) ────────────────────────────────────────────
VITE_RENDER_SRI_API_URL=https://cordova-sri-api.onrender.com

# ── Backend Express (Render.com) ─────────────────────────────────────────────
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ── Seguridad Backend ────────────────────────────────────────────────────────
API_KEY=tu-api-key-secreta-aqui
ALLOWED_ORIGINS=https://imprentacordova.com,https://www.imprentacordova.com

# ── SRI Ambiente ─────────────────────────────────────────────────────────────
# 1 = Pruebas, 2 = Producción
SRI_AMBIENTE=1
