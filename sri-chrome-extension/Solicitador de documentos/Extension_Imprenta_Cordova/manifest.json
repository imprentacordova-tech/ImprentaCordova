{
  "manifest_version": 3,
  "name": "SRI Solicitador Cordova",
  "version": "2.4.1",
  "description": "Automatización Élite SRI & Gestión de Órdenes - Imprenta Córdova",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://*.sri.gob.ec/*",
    "https://cordova-sri-api.onrender.com/*",
    "https://www.imprentacordova.net/*",
    "https://imprentacordova.net/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SRI Solicitador Cordova"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://srienlinea.sri.gob.ec/facturacion-internet/*"],
      "js": ["content/overrides.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://srienlinea.sri.gob.ec/facturacion-internet/*"],
      "js": ["cordovaApi.js", "precios.js", "content/content.js"],
      "css": ["content/inject.css"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.imprentacordova.net/*", "https://imprentacordova.net/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": ["https://srienlinea.sri.gob.ec/*"]
    }
  ]
}
