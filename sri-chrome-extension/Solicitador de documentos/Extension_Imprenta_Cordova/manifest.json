{
  "manifest_version": 3,
  "name": "SRI Solicitador Cordova",
  "version": "2.3.0",
  "description": "Automatización Élite SRI & Gestión de Órdenes - Imprenta Córdova",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.sri.gob.ec/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SRI Solicitador Cordova"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.sri.gob.ec/*"],
      "js": ["content/overrides.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.sri.gob.ec/*"],
      "js": ["content/content.js"],
      "css": ["content/inject.css"],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": ["https://srienlinea.sri.gob.ec/*"]
    }
  ]
}
