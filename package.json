    "lucide-react": "0.378.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.0.379",
    "react": "18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "6.23.0",
    "react-use": "^17.6.0",
    "recharts": "2.12.7"
